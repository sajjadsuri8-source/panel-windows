<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Panel</AssemblyName>
    <RootNamespace>PanelApp</RootNamespace>
    <ApplicationIcon>Panel.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>Panel</Authors>
    <Product>Panel</Product>
    <Description>Multi-company dashboard desktop application</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3405.78" />
  </ItemGroup>
</Project>
